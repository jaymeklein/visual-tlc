{
  "name": "visual-tlc",
  "displayName": "Visual TLC — Spec-Driven Tracker",
  "description": "Track the specs produced by the tlc-spec-driven skill at a glance: phases, tasks, traceability, verification, and incomplete-spec warnings. An independent, unofficial project.",
  "version": "0.1.1",
  "publisher": "JaymeKlein",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#161b22",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "spec-driven",
    "tlc",
    "specs",
    "tasks",
    "claude",
    "SDD"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.specs/**",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tlcSpecs",
          "title": "TLC Specs",
          "icon": "media/tlc.svg"
        }
      ]
    },
    "views": {
      "tlcSpecs": [
        {
          "id": "tlcSpecs.features",
          "name": "Features"
        },
        {
          "id": "tlcSpecs.project",
          "name": "Project"
        },
        {
          "type": "webview",
          "id": "tlcSpecs.panel",
          "name": "Dashboard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tlcSpecs.features",
        "contents": "No specs folder found in this workspace.\nThe extension reads the folders in the tlcSpecs.specsFolders setting, relative to the workspace root (.specs by default).\nFeatures show up here as soon as the /tlc-spec-driven skill creates .specs/features/<feature>/spec.md.\n[Refresh](command:tlcSpecs.refresh)",
        "when": "!tlcSpecs.hasSpecs"
      },
      {
        "view": "tlcSpecs.project",
        "contents": "No STATE.md or recorded lessons yet.",
        "when": "!tlcSpecs.hasSpecs"
      }
    ],
    "commands": [
      {
        "command": "tlcSpecs.refresh",
        "title": "Refresh",
        "category": "TLC Specs",
        "icon": "$(refresh)"
      },
      {
        "command": "tlcSpecs.showHidden",
        "title": "Show Hidden Specs",
        "category": "TLC Specs",
        "icon": "$(eye-closed)"
      },
      {
        "command": "tlcSpecs.hideHidden",
        "title": "Hide Hidden Specs",
        "category": "TLC Specs",
        "icon": "$(eye)"
      },
      {
        "command": "tlcSpecs.hideFeature",
        "title": "Hide Spec",
        "category": "TLC Specs",
        "icon": "$(eye)"
      },
      {
        "command": "tlcSpecs.unhideFeature",
        "title": "Unhide Spec",
        "category": "TLC Specs",
        "icon": "$(eye-closed)"
      },
      {
        "command": "tlcSpecs.openDashboard",
        "title": "Open Dashboard in Editor Tab",
        "category": "TLC Specs",
        "icon": "$(link-external)"
      },
      {
        "command": "tlcSpecs.showFeature",
        "title": "Open Feature in Dashboard",
        "category": "TLC Specs",
        "icon": "$(dashboard)"
      },
      {
        "command": "tlcSpecs.previewFeatureMarkdown",
        "title": "Preview Spec Markdown",
        "category": "TLC Specs",
        "icon": "$(open-preview)"
      },
      {
        "command": "tlcSpecs.revealFeatureFolder",
        "title": "Reveal Feature Folder",
        "category": "TLC Specs",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tlcSpecs.openFile",
        "title": "Open File",
        "category": "TLC Specs"
      },
      {
        "command": "tlcSpecs.previewFile",
        "title": "Preview Markdown",
        "category": "TLC Specs"
      },
      {
        "command": "tlcSpecs.openInEditor",
        "title": "Open in Editor",
        "category": "TLC Specs",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tlcSpecs.showHidden",
          "when": "view == tlcSpecs.features && !tlcSpecs.showHidden",
          "group": "navigation@0"
        },
        {
          "command": "tlcSpecs.hideHidden",
          "when": "view == tlcSpecs.features && tlcSpecs.showHidden",
          "group": "navigation@0"
        },
        {
          "command": "tlcSpecs.openDashboard",
          "when": "view == tlcSpecs.features || view == tlcSpecs.panel",
          "group": "navigation@1"
        },
        {
          "command": "tlcSpecs.refresh",
          "when": "view == tlcSpecs.features || view == tlcSpecs.project",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tlcSpecs.previewFeatureMarkdown",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "inline@1"
        },
        {
          "command": "tlcSpecs.revealFeatureFolder",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "inline@2"
        },
        {
          "command": "tlcSpecs.showFeature",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "inline@3"
        },
        {
          "command": "tlcSpecs.hideFeature",
          "when": "view == tlcSpecs.features && viewItem == feature",
          "group": "inline@4"
        },
        {
          "command": "tlcSpecs.unhideFeature",
          "when": "view == tlcSpecs.features && viewItem == feature.hidden",
          "group": "inline@4"
        },
        {
          "command": "tlcSpecs.openInEditor",
          "when": "view == tlcSpecs.features && viewItem == artifact",
          "group": "inline"
        },
        {
          "command": "tlcSpecs.openInEditor",
          "when": "view == tlcSpecs.features && viewItem == artifact",
          "group": "navigation"
        },
        {
          "command": "tlcSpecs.previewFeatureMarkdown",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "navigation@1"
        },
        {
          "command": "tlcSpecs.revealFeatureFolder",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "navigation@2"
        },
        {
          "command": "tlcSpecs.showFeature",
          "when": "view == tlcSpecs.features && (viewItem == feature || viewItem == feature.hidden)",
          "group": "navigation@3"
        },
        {
          "command": "tlcSpecs.hideFeature",
          "when": "view == tlcSpecs.features && viewItem == feature",
          "group": "navigation@4"
        },
        {
          "command": "tlcSpecs.unhideFeature",
          "when": "view == tlcSpecs.features && viewItem == feature.hidden",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "tlcSpecs.showHidden",
          "when": "tlcSpecs.hasSpecs && !tlcSpecs.showHidden"
        },
        {
          "command": "tlcSpecs.hideHidden",
          "when": "tlcSpecs.hasSpecs && tlcSpecs.showHidden"
        },
        {
          "command": "tlcSpecs.showFeature",
          "when": "false"
        },
        {
          "command": "tlcSpecs.previewFeatureMarkdown",
          "when": "false"
        },
        {
          "command": "tlcSpecs.revealFeatureFolder",
          "when": "false"
        },
        {
          "command": "tlcSpecs.hideFeature",
          "when": "false"
        },
        {
          "command": "tlcSpecs.unhideFeature",
          "when": "false"
        },
        {
          "command": "tlcSpecs.openFile",
          "when": "false"
        },
        {
          "command": "tlcSpecs.previewFile",
          "when": "false"
        },
        {
          "command": "tlcSpecs.openInEditor",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TLC Specs",
      "properties": {
        "tlcSpecs.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish spec warnings (incomplete spec/tasks/validation) to the Problems panel."
        },
        "tlcSpecs.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a feature changes phase, is created, or fails verification."
        },
        "tlcSpecs.staleAfterDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Mark an unfinished feature as stale after N days without changes (0 disables)."
        },
        "tlcSpecs.specsFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".specs"
          ],
          "scope": "resource",
          "markdownDescription": "Folders the extension reads specs from. Each entry is a folder path relative to the workspace folder root (`.specs`, `docs/specs`, `packages/api/.specs`). Folders with the same name in other subfolders are not read. Absolute entries, entries with `..`, and globs are ignored with a warning. A folder not named `.specs` only shows up when it contains skill artifacts."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "package": "npm run typecheck && npm test && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
